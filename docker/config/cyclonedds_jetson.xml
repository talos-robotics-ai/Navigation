<?xml version="1.0" encoding="UTF-8" ?>
<!-- OPTIONAL: pins the Jetson nav nodes' DDS to the WiFi NIC. Only needed for the
     (not recommended) native-RViz-over-DDS path; the reliable remote-viz path is
     Foxglove — see docs/system/REMOTE_VISUALIZATION.md.

     Humble's CycloneDDS IGNORES the newer <General><Interfaces><NetworkInterface>
     block, so we must use the deprecated <NetworkInterfaceAddress> to bind a single
     NIC. Without this, every node also advertises the unroutable robot-eth locator
     (192.168.123.x), which poisons endpoint (SEDP) matching from a remote laptop.
     Multicast is off (campus AP blocks it); a unicast Peer reaches the laptop.

     Addresses are environment-specific (DHCP) — update to match your network:
       - NetworkInterfaceAddress = this Jetson's WiFi IP
       - Peer address           = the laptop's WiFi IP
     Use with: CYCLONEDDS_URI=file://<path>/cyclonedds_jetson.xml on every nav terminal.
     A side benefit: it keeps nav DDS off enP8p1s0, freeing the robot link for the
     SONIC controller's LowState. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <NetworkInterfaceAddress>10.251.101.176</NetworkInterfaceAddress>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <!-- 'auto' is required for local discovery when multicast is off (nodes find
           each other by probing well-known ports 0..MaxAutoParticipantIndex on the
           host). Its default cap is ~10 participants/domain, which the nav stack
           exceeds -> later nodes fail "no free participant index" and the planner/
           bridge die. So keep 'auto' but RAISE the cap. (Do NOT use 'none' here: it
           removes the cap but also disables the well-known-port probing, so with
           multicast off the nav nodes wouldn't discover each other.) -->
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>60</MaxAutoParticipantIndex>
      <Peers><Peer address="10.251.100.88"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
