Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.6
    - Class: rviz_default_plugins/Odometry
      Name: DLIO Odom
      Enabled: true
      Topic:
        Value: /dlio/odom_node/odom
        Depth: 5
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /local_voxel_map/obstacles
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Boxes
      Color: 255; 170; 0
    - Class: rviz_default_plugins/Map
      Name: A* Occupancy Grid
      Enabled: true
      Topic:
        Value: /a_star/occupancy_grid
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/Path
      Name: A* Path
      Enabled: true
      Topic:
        Value: /a_star/path
        Depth: 5
        Reliability Policy: Reliable
      Color: 25; 255; 0
      Line Style: Billboards
      Line Width: 0.05
    - Class: rviz_default_plugins/Path
      Name: MPC Predicted Path
      Enabled: true
      Topic:
        Value: /mpc/predicted_path
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 170; 255
      Line Style: Billboards
      Line Width: 0.04
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /global_goal
        Depth: 5
        Reliability Policy: Reliable
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.8
      Yaw: 0.8
